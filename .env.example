# --- API ---
PORT=3000

# Session cookie signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Database (PostgreSQL via docker compose) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automotive_craft

# --- AI provider ---
# Any OpenAI-compatible endpoint works (OpenRouter, Gemini, Ollama).
# Switching provider is a config change, not a code change.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-...
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
